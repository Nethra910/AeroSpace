+/* Home hero watermark. The logo is an opaque light JPEG, so it is inverted (and hue-rotated back to
+   keep the blue) and blended with `screen`: its light backdrop drops out and only the outlined
+   letters and blue "AEROSPACE" glow faintly on the dark page. The mask feathers the image edges. */
+.hero-watermark {
+  height: auto;
+  opacity: .4;
+  filter: invert(1) hue-rotate(180deg);
+  mix-blend-mode: screen;
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent), linear-gradient(180deg, transparent, #000 6%, #000 94%, transparent);
+  -webkit-mask-composite: source-in;
+  mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent), linear-gradient(180deg, transparent, #000 6%, #000 94%, transparent);
+  mask-composite: intersect;
+}
+@media (max-width: 767px) { .hero-watermark { opacity: .22; } }
